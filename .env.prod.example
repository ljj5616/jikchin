# EC2에서 .env.prod로 복사한 뒤 실제 배포 값으로 교체하세요.
# 비밀번호에 $ 등이 포함되어도 그대로 전달되도록 작은따옴표로 감쌉니다.
APP_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/jikchin-app:replace-with-commit-sha
DB_URL=jdbc:mysql://replace-with-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/jikchin?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=REQUIRED
DB_USERNAME=replace-with-app-db-user
DB_PASSWORD='replace-with-app-db-password'
JWT_SECRET='replace-with-a-random-secret-at-least-32-bytes'
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
ASSETS_BASE_URL=https://example.invalid
AWS_REGION=ap-northeast-2
AVATAR_S3_BUCKET=jikchin-avatar-storage
APP_PORT=8080
REPORTS_ENABLED=true
