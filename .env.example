# 로컬 개발 예시입니다. .env로 복사한 뒤 모든 비밀번호와 JWT 키를 교체하세요.
MYSQL_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
ASSETS_BASE_URL=https://example.invalid
MYSQL_PORT=3307
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
REPORTS_ENABLED=true
